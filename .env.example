# 저장소에는 키 이름만 둔다. 실제 값은 .env 에만 넣는다 (.env 는 .gitignore)

# 건축물대장 (공공데이터포털, 국토교통부_건축HUB_건축물대장정보 서비스) - Decoding 키
BUILDING_API_KEY=

# 브이월드 - 지오코더 API 2.0 키와 2D 데이터 API 키가 따로 발급된다
# 각 키 발급 시 서비스 URL에 localhost:8501(과 배포 도메인) 등록
VWORLD_GEOCODER_KEY=
VWORLD_DATA_KEY=

# LLM 공급자: claude | gemini | mock (키·모델명이 없으면 자동으로 mock = 샘플 결과, 외부 전송 없음)
LLM_PROVIDER=mock
# 모델명은 코드에 쓰지 않는다. 예) Claude: claude-haiku-5-5 ("Claude-Haiku-5.5"처럼 써도 됨)
LLM_MODEL_EXTRACT=
LLM_MODEL_WRITE=
# (선택, claude) 실패·확신 낮음·핵심 조건 전무일 때 다시 할 상위 모델. 예) claude-sonnet-5-5
LLM_MODEL_FALLBACK=
# (선택) Claude 거절 시 서버 측 대체 모델 사용: default(기본) | off. Haiku 5.5는 서버 측 대체가 없어 자동으로 안 씀
LLM_CLAUDE_FALLBACKS=
# (선택) Claude effort: low | medium | high (비우면 모델 기본값). 사고(thinking)를 끄므로 high 이하만
LLM_EFFORT=
# (선택) on 이면 사고(thinking)를 켠다. 기본은 꺼서 출력 토큰을 아낀다
LLM_THINKING=
# (선택) 이미지 긴 변 최대 픽셀(기본 1568, 최대 2576). 작은 글씨가 안 읽히면 올린다(토큰 증가)
LLM_IMAGE_MAX_EDGE=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 후순위 (단계 7)
# 네이버 검색: 키를 발급받은 곳에 따라 hub(NAVER API HUB) | developers(네이버 개발자센터)
NAVER_API_STYLE=hub
# HUB: Client ID → X-NCP-APIGW-API-KEY-ID, Client Secret → X-NCP-APIGW-API-KEY (둘 다 필요)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# (선택) HUB 웹문서 검색 엔드포인트를 바꿀 때만. 비우면 기본값 /search/v1/webkr(2026-11-19 확인)
NAVER_HUB_WEB_URL=
# 법제처 Open API 인증값(OC). 신청 때 등록한 IP의 PC에서만 동작 → scripts/sync_ordinances.py 전용
LAW_API_OC=
